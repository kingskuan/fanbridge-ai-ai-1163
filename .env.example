# --- Frontend ---
# After running `npm run hh:deploy:xlayer-testnet` paste the deployed address here
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=195

# --- Hardhat deployer (keep secret, never commit) ---
# Private key of the account that pays gas to deploy the contract.
# Get X Layer Testnet OKB from https://www.okx.com/xlayer/faucet
PRIVATE_KEY=

# Custom RPC endpoints (optional - defaults are wired in hardhat.config.ts)
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_RPC=https://rpc.xlayer.tech

# OKLink API key for contract verification (optional)
OKLINK_API_KEY=
